# --------------------------------------------------------------------------- #
# Generated outputs -- every file under outputs/ is produced by run_tnr.jl
# / run_tnr_multiscenario.jl / run_scenario_dcopf.jl. Regenerate, don't commit.
# --------------------------------------------------------------------------- #
outputs/

# --------------------------------------------------------------------------- #
# Paper source. Only the compiled PDF is published (see reference/); the .tex
# stays local.
# --------------------------------------------------------------------------- #
*.tex
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# --------------------------------------------------------------------------- #
# Multi-scenario pipeline. Only runs against the ACTIVSg scenario matrices
# below, which aren't published, so it stays local until it has a runner that
# works on the bundled cases.
# --------------------------------------------------------------------------- #
tnr_multiscenario.jl
run_tnr_multiscenario.jl
run_scenario_dcopf.jl
kron_reduction/run_tnr_kron_multiscenario.jl

# --------------------------------------------------------------------------- #
# Large / third-party case data. case14 and case118 are the only case files
# kept in git (they're small and are the quick-start / default examples).
# Everything else -- the large PGLib-OPF cases and the full ACTIVSg synthetic
# grids (PowerWorld binaries + multi-year scenario matrices) -- is fetched
# separately; see README.md "Case data" for sources and where to put them.
# --------------------------------------------------------------------------- #
case studies/ACTIVSg200/
case studies/ACTIVSg2000/
case studies/pglib_opf_case300_ieee.m
case studies/pglib_opf_case500_goc.m
case studies/pglib_opf_case2000_goc.m
case studies/pglib_opf_case6515_rte.m

# --------------------------------------------------------------------------- #
# Solver / debug artifacts
# --------------------------------------------------------------------------- #
*.log
gurobi.log

# --------------------------------------------------------------------------- #
# Editor / OS cruft
# --------------------------------------------------------------------------- #
.claude/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
.$*.bkp
